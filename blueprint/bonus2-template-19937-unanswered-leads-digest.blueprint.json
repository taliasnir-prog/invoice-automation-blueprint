        {
            "id": 3,
            "module": "util:SetVariable2",
            "version": 1,
            "parameters": {},
            "filter": {
                "name": "Real row; no reply marker; valid timestamp shape",
                "conditions": [
                    [
                        {
                            "a": "{{2.__IMTLENGTH__}}",
                            "b": "0",
                            "o": "number:greater"
                        },
                        {
                            "a": "{{trim(ifempty(2.`4`; emptystring))}}",
                            "b": "",
                            "o": "text:equal"
                        },
                        {
                            "a": "{{2.`3`}}",
                            "b": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
                            "o": "text:pattern"
                        }
                    ]
                ]
            },
            "mapper": {
                "name": "created_at",
                "scope": "roundtrip",
                "value": "{{parseDate(2.`3`; \"YYYY-MM-DDTHH:mm:ss[Z]\"; \"UTC\")}}"
            },
            "metadata": {
                "designer": {
                    "x": 660,
                    "y": 0,
                    "name": "Parse a valid UTC received timestamp"
                }
            }
        },
        {
            "id": 4,
            "module": "util:TextAggregator",
            "version": 1,
            "parameters": {
                "feeder": 2,
                "rowSeparator": "\n"
            },
            "filter": {
                "name": "No reply after at least N complete days",
                "conditions": [
                    [
                        {
                            "a": "{{3.created_at}}",
                            "b": "{{addDays(now; 0 - parseNumber(1.wait_days; \".\"))}}",
                            "o": "date:lessorequal"
                        }
                    ]
                ]
            },
            "mapper": {
                "value": "<li><strong>{{escapeHTML(2.`2`)}}</strong> — {{escapeHTML(2.`1`)}}<br>Received: {{escapeHTML(2.`3`)}}; lead key: {{escapeHTML(2.`0`)}}</li>"
            },
            "metadata": {
                "designer": {
                    "x": 980,
                    "y": 0,
                    "name": "Collect all qualifying leads into one email body"
                }
            },
            "flags": {
                "stopIfEmpty": true
            }
