{
    "name": "AIDO L5 Bonus 2 - Template 19937: Unanswered Leads Daily Digest",
    "flow": [
        {
            "id": 1,
            "module": "util:SetVariables",
            "version": 1,
            "parameters": {},
            "mapper": {
                "scope": "roundtrip",
                "variables": [
                    {
                        "name": "owner_email",
                        "value": "owner@example.invalid"
                    },
                    {
                        "name": "wait_days",
                        "value": "3"
                    }
                ]
            },
            "metadata": {
                "designer": {
                    "x": 0,
                    "y": 0,
                    "name": "Daily digest settings: owner and three-day age"
                }
            }
        },
        {
            "id": 2,
            "module": "google-sheets:filterRows",
            "version": 2,
            "parameters": {
                "__IMTCONN__": 13095202
            },
            "mapper": {
                "from": "drive",
                "limit": 100,
                "filter": [
                    [
                        {
                            "a": "F",
                            "b": "open",
                            "o": "text:equal"
                        }
                    ]
                ],
                "sheetId": "Unanswered_Leads",
                "sortOrder": "asc",
                "spreadsheetId": "REPLACE_WITH_YOUR_SPREADSHEET_ID",
                "tableFirstRow": "A1:F1",
                "includesHeaders": true,
                "valueRenderOption": "UNFORMATTED_VALUE",
                "dateTimeRenderOption": "FORMATTED_STRING"
            },
            "metadata": {
                "designer": {
                    "x": 340,
                    "y": 0,
                    "name": "Read open leads (maximum 100; see setup cap)"
                },
                "restore": {
                    "mapper": {
                        "spreadsheetId": {
                            "label": "Unanswered Leads - Demo (AIDO L5 bonus 2)"
                        }
                    }
                }
            }
        },
        {
            "id": 3,
            "module": "util:SetVariable2",
            "version": 1,
            "parameters": {},
            "filter": {
                "name": "Real row; no reply marker; valid timestamp shape",
                "conditions": [
                    [
                        {
                            "a": "{{2.__IMTLENGTH__}}",
                            "b": "0",
                            "o": "number:greater"
                        },
                        {
                            "a": "{{trim(ifempty(2.`4`; emptystring))}}",
                            "b": "",
                            "o": "text:equal"
                        },
                        {
                            "a": "{{2.`3`}}",
                            "b": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
                            "o": "text:pattern"
                        }
                    ]
                ]
            },
            "mapper": {
                "name": "created_at",
                "scope": "roundtrip",
                "value": "{{parseDate(2.`3`; \"YYYY-MM-DDTHH:mm:ss[Z]\"; \"UTC\")}}"
            },
            "metadata": {
                "designer": {
                    "x": 660,
                    "y": 0,
                    "name": "Parse a valid UTC received timestamp"
                }
            }
        },
        {
            "id": 4,
            "module": "util:TextAggregator",
            "version": 1,
            "parameters": {
                "feeder": 2,
                "rowSeparator": "\n"
            },
            "filter": {
                "name": "No reply after at least N complete days",
                "conditions": [
                    [
                        {
                            "a": "{{3.created_at}}",
                            "b": "{{addDays(now; 0 - parseNumber(1.wait_days; \".\"))}}",
                            "o": "date:lessorequal"
                        }
                    ]
                ]
            },
            "mapper": {
                "value": "<li><strong>{{escapeHTML(2.`2`)}}</strong> — {{escapeHTML(2.`1`)}}<br>Received: {{escapeHTML(2.`3`)}}; lead key: {{escapeHTML(2.`0`)}}</li>"
            },
            "metadata": {
                "designer": {
                    "x": 980,
                    "y": 0,
                    "name": "Collect all qualifying leads into one email body"
                }
            },
            "flags": {
                "stopIfEmpty": true
            }
        },
        {
            "id": 5,
            "module": "google-email:sendAnEmail",
            "version": 4,
            "parameters": {
                "__IMTCONN__": 13095130
            },
            "filter": {
                "name": "Send only a non-empty digest",
                "conditions": [
                    [
                        {
                            "a": "{{length(trim(4.text))}}",
                            "b": "0",
                            "o": "number:greater"
                        }
                    ]
                ]
            },
            "mapper": {
                "to": [
                    "{{1.owner_email}}"
                ],
                "content": "<p>These open leads have no reply marker and are at least {{escapeHTML(1.wait_days)}} complete days old.</p><ul>{{4.text}}</ul><p>Scan cap: 100 open rows. Update last_reply_at_utc or status in your sheet after reviewing a lead.</p>",
                "subject": "Unanswered leads — {{formatDate(now; \"YYYY-MM-DD\"; \"UTC\")}}",
                "bodyType": "rawHtml"
            },
            "metadata": {
                "designer": {
                    "x": 1340,
                    "y": 0,
                    "name": "Send one digest to the owner only"
                }
            }
        }
    ],
    "metadata": {
        "instant": false,
        "version": 1,
        "scenario": {
            "roundtrips": 1,
            "maxErrors": 3,
            "autoCommit": true,
            "sequential": false,
            "slots": null,
            "confidential": false,
            "dataloss": false,
            "dlq": false
        },
        "designer": {
            "orphans": []
        },
        "zone": "eu1.make.com",
        "notes": []
    }
}
